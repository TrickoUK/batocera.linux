config BR2_PACKAGE_ARES
	bool "ares"
	depends on BR2_x86_64
	depends on BR2_INSTALL_LIBSTDCPP && BR2_PACKAGE_HAS_LIBGL && BR2_TOOLCHAIN_GCC_AT_LEAST_13
	select BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_SDL3
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_XLIB_LIBXRANDR
	help
	  Multi-system emulator descended from higan/bsnes. This fork builds
	  it scoped to Nintendo 64 and Super Nintendo/Super Famicom only
	  (ARES_CORES=n64;sfc) rather than its full system list.

	  https://ares-emu.net

comment "ares needs a toolchain w/ C++23, OpenGL, GTK3"
	depends on BR2_x86_64
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_PACKAGE_HAS_LIBGL || !BR2_TOOLCHAIN_GCC_AT_LEAST_13
