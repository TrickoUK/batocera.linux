+//batocera: thumbnail written next to a save-state file (<rom>.bs<slot>.png), for frontends
+//(EmulationStation's save-state browser) that expect a sidecar preview image per slot.
+auto Program::captureStateScreenshot(const u32* data, u32 pitch, u32 width, u32 height, u32 slot) -> void {
+  string filename{emulator->locate(emulator->game->location, {".bs", slot, ".png"}, settings.paths.saves)};
+  Encode::PNG::RGB8(filename, data, pitch, width, height);
+}
