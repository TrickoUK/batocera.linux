+/* USB GunCon2 device model, sourced directly from the libretro
+ * RETRO_DEVICE_LIGHTGUN input callbacks. The device/report protocol below
+ * (descriptors, button bit positions, calibration control request, and the
+ * per-game position scale/center table) matches upstream PCSX2's
+ * USB/usb-lightgun/guncon2.cpp byte-for-byte, since games decode this over
+ * the emulated USB wire - only the host-input binding layer differs:
+ * upstream drives this from InputManager pointer/binding values and an
+ * ImGui software cursor, here it is pumped from the frontend's lightgun
+ * device each frame with no cursor overlay. */
+
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <tuple>
+
+#include "USB/libretro-usb/USBinternal.h"
