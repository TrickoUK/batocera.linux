+	static constexpr float DEFAULT_SCALE_Y = 1.0f;
+
+#pragma pack(push, 1)
+	union GunCon2Out
+	{
+		u8 bits[6];
+
+		struct
+		{
+			u16 buttons;
+			s16 pos_x;
+			s16 pos_y;
+		};
+	};
+	static_assert(sizeof(GunCon2Out) == 6);
+#pragma pack(pop)
+
+	struct GunCon2State
+	{
+		explicit GunCon2State(u32 port_) : port(port_) {}
+
+		USBDevice dev{};
+		USBDesc desc{};
+		USBDescDevice desc_dev{};
+
+		u32 port = 0;
+
+		//////////////////////////////////////////////////////////////////////////
+		// Screen calibration (auto-detected from the disc serial, like upstream)
+		//////////////////////////////////////////////////////////////////////////
+		u32 screen_width = DEFAULT_SCREEN_WIDTH;
+		u32 screen_height = DEFAULT_SCREEN_HEIGHT;
+		float center_x = DEFAULT_CENTER_X;
+		float center_y = DEFAULT_CENTER_Y;
+		float scale_x = DEFAULT_SCALE_X;
+		float scale_y = DEFAULT_SCALE_Y;
+		bool auto_config_done = false;
+
+		//////////////////////////////////////////////////////////////////////////
+		// Host state, refreshed once per frame from the frontend
+		//////////////////////////////////////////////////////////////////////////
+		u32 button_state = 0;
+		s16 raw_screen_x = 0;
+		s16 raw_screen_y = 0;
+		bool offscreen = true;
+
+		//////////////////////////////////////////////////////////////////////////
+		// Device state (game-configured offset)
+		//////////////////////////////////////////////////////////////////////////
+		s16 param_x = 0;
+		s16 param_y = 0;
+		u16 param_mode = 0;
+
+		u16 calibration_timer = 0;
+		s16 calibration_pos_x = 0;
+		s16 calibration_pos_y = 0;
+
+		void AutoConfigure();
+		std::tuple<s16, s16> CalculatePosition() const;
+	};
+
+	static const USBDescStrings desc_strings = {
+		"Namco GunCon2",
+	};
+
+	/* mostly the same values as the Bochs USB Keyboard device */
+	static const uint8_t guncon2_dev_desc[] = {
+		/* bLength             */ 0x12,
+		/* bDescriptorType     */ 0x01,
+		/* bcdUSB              */ WBVAL(0x0100),
+		/* bDeviceClass        */ 0x00,
+		/* bDeviceSubClass     */ 0x00,
+		/* bDeviceProtocol     */ 0x00,
+		/* bMaxPacketSize0     */ 0x08,
+		/* idVendor            */ WBVAL(0x0b9a),
+		/* idProduct           */ WBVAL(0x016a),
+		/* bcdDevice           */ WBVAL(0x0100),
+		/* iManufacturer       */ 0x00,
+		/* iProduct            */ 0x00,
+		/* iSerialNumber       */ 0x00,
+		/* bNumConfigurations  */ 0x01,
+	};
+
+	static const uint8_t guncon2_config_desc[] = {
+		0x09, // Length
+		0x02, // Type (Config)
+		0x19, 0x00, // Total size
+
+		0x01, // # interfaces
+		0x01, // Configuration #
+		0x00, // index of string descriptor
+		0x80, // Attributes (bus powered)
+		0x19, // Max power in mA
+
+		// Interface
+		0x09, // Length
+		0x04, // Type (Interface)
+
+		0x00, // Interface #
+		0x00, // Alternative #
+		0x01, // # endpoints
+
+		0xff, // Class
+		0x6a, // Subclass
+		0x00, // Protocol
+		0x00, // index of string descriptor
+
+		// Endpoint
+		0x07, // Length
+		0x05, // Type (Endpoint)
+
+		0x81, // Address
+		0x03, // Attributes (interrupt transfers)
+		0x08, 0x00, // Max packet size
+
+		0x08, // Polling interval (frame counts)
+	};
+
+	static void updateState(GunCon2State* us, u32 bid, bool pressed)
+	{
+		const u32 bit = 1u << bid;
+		if (pressed)
+			us->button_state |= bit;
+		else
+			us->button_state &= ~bit;
+	}
+
+	static void guncon2_handle_control(
+		USBDevice* dev, USBPacket* p, int request, int value, int index, int length, uint8_t* data)
+	{
+		GunCon2State* const us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+
+		// Apply configuration on the first control packet.
+		// The ELF should be well and truely loaded by then.
+		if (!us->auto_config_done)
+		{
+			us->AutoConfigure();
+			us->auto_config_done = true;
+		}
+
+		if (usb_desc_handle_control(dev, p, request, value, index, length, data) >= 0)
+			return;
+
+		if (request == (ClassInterfaceOutRequest | 0x09))
+		{
+			us->param_x = static_cast<u16>(data[0]) | (static_cast<u16>(data[1]) << 8);
+			us->param_y = static_cast<u16>(data[2]) | (static_cast<u16>(data[3]) << 8);
+			us->param_mode = static_cast<u16>(data[4]) | (static_cast<u16>(data[5]) << 8);
+			return;
+		}
+
+		p->status = USB_RET_STALL;
+	}
+
+	static void guncon2_handle_data(USBDevice* dev, USBPacket* p)
+	{
+		GunCon2State* const us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+
+		switch (p->pid)
+		{
+			case USB_TOKEN_IN:
+			{
+				if (p->ep->nr == 1)
+				{
+					const auto [pos_x, pos_y] = us->CalculatePosition();
+
+					// Time Crisis games do a "calibration" by displaying a black frame for a single frame,
+					// waiting for the gun to report (0, 0), and then computing an offset on the first non-zero
+					// value. So, after the trigger is pulled, we wait for a few frames, then send the (0, 0)
+					// report, then go back to normal values.
+					if (us->button_state & (1u << BID_RECALIBRATE) && us->calibration_timer == 0)
+					{
+						us->calibration_timer = GUNCON2_CALIBRATION_DELAY;
+						us->calibration_pos_x = pos_x;
+						us->calibration_pos_y = pos_y;
+					}
+
+					// Buttons are active low.
+					GunCon2Out out;
+					out.buttons = static_cast<u16>(~us->button_state) | (us->param_mode & GUNCON2_FLAG_PROGRESSIVE);
+					out.pos_x = pos_x;
+					out.pos_y = pos_y;
+
+					if (us->calibration_timer > 0)
+					{
+						// Force trigger down while calibrating.
+						out.buttons &= ~(1u << BID_TRIGGER);
+						out.pos_x = us->calibration_pos_x;
+						out.pos_y = us->calibration_pos_y;
+						us->calibration_timer--;
+
+						if (us->calibration_timer < GUNCON2_CALIBRATION_REPORT_DELAY)
+						{
+							out.pos_x = 0;
+							out.pos_y = 0;
+						}
+					}
+					else if (us->button_state & (1u << BID_SHOOT_OFFSCREEN))
+					{
+						// Offscreen shot - use 0,0.
+						out.buttons &= ~(1u << BID_TRIGGER);
+						out.pos_x = 0;
+						out.pos_y = 0;
+					}
+
+					usb_packet_copy(p, &out, sizeof(out));
+					break;
+				}
+			}
+				[[fallthrough]];
+
+			case USB_TOKEN_OUT:
+			default:
+			{
+				p->status = USB_RET_STALL;
+			}
+			break;
+		}
+	}
+
+	static void guncon2_unrealize(USBDevice* dev)
+	{
+		GunCon2State* us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+		delete us;
+	}
+
+	void GunCon2State::AutoConfigure()
+	{
+		const std::string serial = VMManager::GetDiscSerial();
+		for (const GameConfig& gc : s_game_config)
+		{
+			if (serial != gc.serial)
+				continue;
+
+			scale_x = gc.scale_x / 100.0f;
+			scale_y = gc.scale_y / 100.0f;
+			center_x = static_cast<float>(gc.center_x);
+			center_y = static_cast<float>(gc.center_y);
+			screen_width = gc.screen_width;
+			screen_height = gc.screen_height;
+			return;
+		}
+	}
+
+	std::tuple<s16, s16> GunCon2State::CalculatePosition() const
+	{
+		s16 pos_x, pos_y;
+
+		if (offscreen)
+		{
+			// off-screen
+			pos_x = 0;
+			pos_y = 0;
+		}
+		else
+		{
+			// raw_screen_{x,y} are -0x8000..0x7fff across the visible display,
+			// per the libretro RETRO_DEVICE_ID_LIGHTGUN_SCREEN_{X,Y} contract.
+			const float x_norm = (static_cast<float>(raw_screen_x) + 32768.0f) / 65535.0f;
+			const float y_norm = (static_cast<float>(raw_screen_y) + 32768.0f) / 65535.0f;
+
+			// scale to internal coordinate system and center
+			float fx = (x_norm * static_cast<float>(screen_width)) - static_cast<float>(screen_width / 2u);
+			float fy = (y_norm * static_cast<float>(screen_height)) - static_cast<float>(screen_height / 2u);
+
+			// apply curvature scale
+			fx *= scale_x;
+			fy *= scale_y;
+
+			// and re-center based on game center
+			s32 x = static_cast<s32>(std::round(fx + center_x));
+			s32 y = static_cast<s32>(std::round(fy + center_y));
+
+			// apply game-configured offset
+			if (param_mode & GUNCON2_FLAG_PROGRESSIVE)
+			{
+				x -= param_x / 2;
+				y -= param_y / 2;
+			}
+			else
+			{
+				x -= param_x;
+				y -= param_y;
+			}
+
+			// 0,0 is reserved for offscreen, so ensure we don't send that
+			pos_x = static_cast<s16>(std::max(x, 1));
+			pos_y = static_cast<s16>(std::max(y, 1));
+		}
+
+		return std::tie(pos_x, pos_y);
+	}
+
+	USBDevice* usb_guncon2_create(u32 port)
+	{
+		GunCon2State* s = new GunCon2State(port);
+		s->desc.full = &s->desc_dev;
+		s->desc.str = desc_strings;
+
+		if (usb_desc_parse_dev(guncon2_dev_desc, sizeof(guncon2_dev_desc), s->desc, s->desc_dev) < 0)
+			goto fail;
+		if (usb_desc_parse_config(guncon2_config_desc, sizeof(guncon2_config_desc), s->desc_dev) < 0)
+			goto fail;
+
+		s->dev.speed = USB_SPEED_FULL;
+		s->dev.klass.handle_attach = usb_desc_attach;
+		s->dev.klass.handle_control = guncon2_handle_control;
+		s->dev.klass.handle_data = guncon2_handle_data;
+		s->dev.klass.unrealize = guncon2_unrealize;
+		s->dev.klass.usb_desc = &s->desc;
+		s->dev.klass.product_desc = s->desc.str[0];
+
+		usb_desc_init(&s->dev);
+		usb_ep_init(&s->dev);
+
+		return &s->dev;
+	fail:
+		guncon2_unrealize(&s->dev);
+		return nullptr;
+	}
+
+	void usb_guncon2_update(USBDevice* dev, retro_input_state_t input_cb, unsigned port)
+	{
+		GunCon2State* us = USB_CONTAINER_OF(dev, GunCon2State, dev);
+		if (!input_cb)
+			return;
+
+		us->offscreen = input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_IS_OFFSCREEN) != 0;
+		us->raw_screen_x = static_cast<s16>(input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_SCREEN_X));
+		us->raw_screen_y = static_cast<s16>(input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, RETRO_DEVICE_ID_LIGHTGUN_SCREEN_Y));
+
+		const auto poll = [&](u32 bid, unsigned id)
+		{
+			updateState(us, bid, input_cb(port, RETRO_DEVICE_LIGHTGUN, 0, id) != 0);
+		};
+
+		// This mirrors standalone PCSX2's own per-button assignment for a
+		// real detected gun (package/batocera/emulators/pcsx2/005-lightguns.patch's
+		// udev_handle_event(): BTN_LEFT/RIGHT/MIDDLE/1/2/3/4 -> TRIGGER/C/
+		// START/B/RECALIBRATE/A/SELECT), not a name-for-name match against
+		// libretro's own AUX_A/AUX_B/AUX_C/RELOAD/SELECT labels - those
+		// don't line up 1:1 with GunCon2's buttons. configgen/gun.py's
+		// identically-ordered mouse_buttons_to_code map (left, right,
+		// middle, 1, 2, 3, 4, ...) confirms batocera's generic RetroArch
+		// "gun_*_mbtn" roles (trigger/offscreen_shot/start/select/aux_a/
+		// aux_b/aux_c) are assigned to that exact same physical-button
+		// ordinal sequence, so matching PCSX2 means following the ordinal,
+		// not the libretro role name: ordinal 2 ("offscreen_shot"/RELOAD)
+		// is PCSX2's C button, not a "shoot offscreen" gesture; ordinal 4
+		// ("select") is PCSX2's B button; ordinal 5 ("aux_a") is PCSX2's
+		// Recalibrate; ordinal 6 ("aux_b") is PCSX2's A button; ordinal 7
+		// ("aux_c") is PCSX2's Select button.
+		poll(BID_TRIGGER,     RETRO_DEVICE_ID_LIGHTGUN_TRIGGER); // ordinal 1 (BTN_LEFT)
+		poll(BID_C,           RETRO_DEVICE_ID_LIGHTGUN_RELOAD);  // ordinal 2 (BTN_RIGHT)
+		poll(BID_START,       RETRO_DEVICE_ID_LIGHTGUN_START);   // ordinal 3 (BTN_MIDDLE)
+		poll(BID_B,           RETRO_DEVICE_ID_LIGHTGUN_SELECT);  // ordinal 4 (BTN_1)
+		poll(BID_RECALIBRATE, RETRO_DEVICE_ID_LIGHTGUN_AUX_A);   // ordinal 5 (BTN_2)
+		poll(BID_A,           RETRO_DEVICE_ID_LIGHTGUN_AUX_B);   // ordinal 6 (BTN_3)
+		poll(BID_SELECT,      RETRO_DEVICE_ID_LIGHTGUN_AUX_C);   // ordinal 7 (BTN_4)
+		poll(BID_DPAD_UP,     RETRO_DEVICE_ID_LIGHTGUN_DPAD_UP);    // ordinal 8  (BTN_5)
+		poll(BID_DPAD_DOWN,   RETRO_DEVICE_ID_LIGHTGUN_DPAD_DOWN);  // ordinal 9  (BTN_6)
+		poll(BID_DPAD_LEFT,   RETRO_DEVICE_ID_LIGHTGUN_DPAD_LEFT);  // ordinal 10 (BTN_7)
+		poll(BID_DPAD_RIGHT,  RETRO_DEVICE_ID_LIGHTGUN_DPAD_RIGHT); // ordinal 11 (BTN_8)
+	}
+} // namespace usb_guncon2
