 static Result ResizeGLScreen(unsigned *xOffsetPtr, unsigned *yOffsetPtr, unsigned *xResPtr, unsigned *yResPtr, unsigned *totalXResPtr, unsigned *totalYResPtr, bool keepAspectRatio, bool fullScreen)
 {
+  // Explicitly strip window decorations before requesting fullscreen (and restore
+  // them otherwise, unless the user always wants a borderless window). On some
+  // compositors (e.g. Wayland/xdg-shell) SDL_SetWindowFullscreen() alone does not
+  // reliably remove decorations, which can leave a gap the size of the old title
+  // bar even once the window claims to be fullscreen.
+  bool borderless = fullScreen || s_runtime_config["BorderlessWindow"].ValueAs<bool>();
+  SDL_SetWindowBordered(s_window, borderless ? SDL_FALSE : SDL_TRUE);
+
   // Set full screen mode
   if (SDL_SetWindowFullscreen(s_window, fullScreen ? SDL_WINDOW_FULLSCREEN : 0) < 0)
   {
     ErrorLog("Unable to enter %s mode: %s\n", fullScreen ? "fullscreen" : "windowed", SDL_GetError());
     return Result::FAIL;
   }
 
+  // Give the window manager/compositor a chance to finish negotiating the
+  // resize/fullscreen transition (this is asynchronous on Wayland) before we
+  // query the window size below -- otherwise SetGLGeometry() can compute the
+  // GL viewport against stale, pre-transition geometry, which is what produces
+  // the leftover gap/band at the edge of the screen.
+  int prevW = -1, prevH = -1;
+  for (int i = 0; i < 20; i++)
+  {
+    SDL_PumpEvents();
+    int w, h;
+    SDL_GetWindowSize(s_window, &w, &h);
+    if (w == prevW && h == prevH)
+      break;
+    prevW = w;
+    prevH = h;
+    SDL_Delay(10);
+  }
+
   return SetGLGeometry(xOffsetPtr, yOffsetPtr, xResPtr, yResPtr, totalXResPtr, totalYResPtr, keepAspectRatio);
 }
 
