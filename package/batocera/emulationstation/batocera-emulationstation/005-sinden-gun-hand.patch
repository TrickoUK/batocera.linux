+// event number of a /dev/input/eventN gun, -1 if unknown
+static int gunEventNumber(Gun* gun)
+{
+	std::string path = gun->devicePath();
+	if (!Utils::String::startsWith(path, "/dev/input/event"))
+		return -1;
+
+	return Utils::String::toInteger(path.substr(16));
+}
+
+// Sinden gun set to left hand mode (sinden_hand_pN): batocera-launch numbers the players by gun event number
+static bool isLeftHandedGun(Gun* gun, std::vector<Gun*>& guns)
+{
+	if (gun->name() != "Sinden lightgun")
+		return false;
+
+	int eventNumber = gunEventNumber(gun);
+	if (eventNumber < 0)
+		return false;
+
+	int player = 1;
+	for (auto other : guns)
+	{
+		int otherNumber = gunEventNumber(other);
+		if (otherNumber >= 0 && otherNumber < eventNumber)
+			player++;
+	}
+
+	return SystemConf::getInstance()->get("global.sinden_hand_p" + std::to_string(player)) == "left";
+}
