+// read by batocera-launch (in-game button mirror) and the controller activity gun icon
+void GuiControllersSettings::openControllersSpecificSettings_sindengunhand()
+{
+	GuiSettings* s = new GuiSettings(mWindow, _("SINDEN GUN HAND").c_str());
+
+	for (int player = 1; player <= 4; player++)
+		s->addOptionList(Utils::String::format(_("PLAYER %i GUN HAND").c_str(), player),
+			_("Left hand mirrors the front and rear side buttons of this player's gun in games (the D-pad stays on the left)."),
+			{ { _("RIGHT"), "" }, { _("LEFT"), "left" } }, "global.sinden_hand_p" + std::to_string(player), false, nullptr);
+
+	mWindow->pushGui(s);
+}
